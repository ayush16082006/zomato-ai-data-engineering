# =========================================================
# 1. SECRETS & CREDENTIALS
# =========================================================

.env
.env.*
!.env.example

# Google Cloud / BigQuery credentials
*service-account*.json
*gcp*.json
credentials.json
*-credentials.json

# Private keys / certificates
*.key
*.pem
*.p12
*.pfx

# API keys / local secret files
secrets/
.streamlit/secrets.toml


# =========================================================
# 2. PYTHON VIRTUAL ENVIRONMENTS
# =========================================================

venv/
.venv/
env/
ENV/
.env_venv/

# Conda environments
conda-env/
.conda/


# =========================================================
